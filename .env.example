# PostgreSQL (Billing, Deployments & LangGraph Checkpointer)
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=aegis_secret_pwd
POSTGRES_DB=aegisops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Qdrant (Hybrid Vector DB: Dense + BM25 Sparse)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis (Semantic Cache & Session State)
REDIS_HOST=localhost
REDIS_PORT=6379

# DuckDB (OLAP Telemetry Store Path)
DUCKDB_PATH=data/telemetry_parquet/aegis_telemetry.duckdb